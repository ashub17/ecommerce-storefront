# Base URL of the Laravel API, including the /api prefix.
# Server-side only: this is deliberately NOT prefixed with NEXT_PUBLIC_, so the
# browser never learns where the API lives and cannot call it directly.
API_URL=http://127.0.0.1:8000

# Public origin of this storefront, used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
